{
  "id": "data-totals",
  "split": "dev",
  "contract": {
    "version": 1,
    "title": "CSV category totals",
    "objective": "Write transform.sh as described in README.md.",
    "agent": "candidate",
    "workspace": {
      "source_dir": "csvtool"
    },
    "acceptance": [
      {
        "id": "transform",
        "kind": "command",
        "command": [
          "sh",
          "check.sh"
        ],
        "overlay_dir": "csvtool-acceptance",
        "must_change": true,
        "timeout_seconds": 60
      }
    ],
    "limits": {
      "max_iterations": 10,
      "timeout_seconds": 60
    }
  }
}
