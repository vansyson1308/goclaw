    "data-totals": {
      "steps": [
        {
          "tool": "write_file",
          "args": {
            "path": "transform.sh",
            "content": "#!/bin/sh\nawk -F, 'NR>2 {t[$1]+=$2} END {for (c in t) print c \",\" t[c]}' \"$1\" | sort\n"
          }
        }
      ],
      "reply": "done"
    },
    "data-totals-report": {
      "steps": [
        {
          "tool": "write_file",
